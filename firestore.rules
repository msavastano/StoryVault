rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // Validation Blueprint for Story
    function isValidStory(data) {
      return data.keys().hasAll(['title', 'author', 'source', 'content', 'createdAt']) &&
             data.title is string && data.title.size() <= 1000 &&
             data.author is string && data.author.size() <= 1000 &&
             data.source is string && data.source.size() <= 2000 &&
             data.content is string && data.content.size() <= 900000 &&
             (!('wordCount' in data) || data.wordCount is number) &&
             (!('totalPages' in data) || data.totalPages is number) &&
             (!('currentPage' in data) || data.currentPage is number);
    }

    // Validation Blueprint for ReaderPreferences
    function isValidReaderPreferences(data) {
      return data.keys().hasOnly(['fontSize', 'fontFamily', 'theme', 'lineSpacing', 'margin', 'updatedAt']) &&
             data.keys().hasAll(['fontSize', 'fontFamily', 'theme', 'lineSpacing', 'margin', 'updatedAt']) &&
             data.fontSize is number && data.fontSize >= 0 && data.fontSize <= 10 &&
             data.fontFamily in ['serif', 'sans'] &&
             data.theme in ['light', 'sepia', 'dark'] &&
             data.lineSpacing in ['tight', 'normal', 'loose'] &&
             data.margin in ['narrow', 'normal', 'wide'] &&
             data.updatedAt == request.time;
    }

    // Story match
    match /users/{userId}/stories/{storyId} {
      // Allow read (both list and get) if the user is the owner
      allow read: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      
      // Allow create
      allow create: if isSignedIn() && 
                    request.auth.uid == userId && 
                    isValidId(userId) && 
                    isValidId(storyId) &&
                    isValidStory(incoming()) &&
                    incoming().createdAt == request.time;
                    
      // Allow delete
      allow delete: if isSignedIn() && 
                    request.auth.uid == userId && 
                    isValidId(userId) && 
                    isValidId(storyId);
      
      allow update: if isSignedIn() &&
                    request.auth.uid == userId &&
                    isValidId(userId) &&
                    isValidId(storyId) &&
                    isValidStory(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['currentPage']) &&
                    incoming().createdAt == existing().createdAt;
    }

    // Reader preferences — single doc per user at preferences/reader
    match /users/{userId}/preferences/{prefId} {
      allow read: if isSignedIn() &&
                    request.auth.uid == userId &&
                    isValidId(userId);

      allow write: if isSignedIn() &&
                    request.auth.uid == userId &&
                    isValidId(userId) &&
                    prefId == 'reader' &&
                    isValidReaderPreferences(incoming());
    }
  }
}
